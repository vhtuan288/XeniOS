          "${PROJECT_SOURCE_DIR}/assets/apple/Acknowledgements.json"
          "$<TARGET_BUNDLE_DIR:xenia-app>/Acknowledgements.json"
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different
          "${PROJECT_SOURCE_DIR}/LICENSE"
          "$<TARGET_BUNDLE_DIR:xenia-app>/LICENSE.txt"
  VERBATIM)
# The NSLocalizedString table: English only for now (keys are the English text), generated by
